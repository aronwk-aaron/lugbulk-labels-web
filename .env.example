# Copy to .env and fill in real values. .env is gitignored — never commit it.

# From the Google Cloud Console: APIs & Services > Credentials >
# OAuth 2.0 Client ID (Web application type). Authorized redirect URI
# must match GOOGLE_OAUTH_REDIRECT_URI below.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback

# 32 random bytes, base64-encoded (e.g. `openssl rand -base64 32`).
# Used to encrypt stored OAuth refresh tokens at rest.
TOKEN_ENCRYPTION_KEY=

# Optional: BrickLink API credentials (https://www.bricklink.com/v2/api/register_consumer.page),
# for part weights (label order) and filling in colors a sheet is missing.
# The access token is tied to an IP address — register the server's.
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN=
BRICKLINK_TOKEN_SECRET=

# --- Abuse protection (see README "Security and abuse limits") ---
# Who may sign in: comma-separated addresses and/or @domains. Strongly
# recommended; empty lets in any Google account that gets past the OAuth
# consent screen.
ALLOWED_EMAILS=
# Set to 1 only when running behind a reverse proxy that sets
# X-Forwarded-For — otherwise every visitor shares the proxy's rate limits
# (unset), or clients can fake their IP (set without a proxy).
TRUST_PROXY=
# Reports generated at once, server-wide (default 2).
MAX_CONCURRENT_JOBS=
# BrickLink API calls per UTC day (default 4000; BrickLink allows 5000).
BRICKLINK_DAILY_CALLS=
